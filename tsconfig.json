{
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "lib-es6",
        "declarationDir": "./types",
        "moduleResolution": "node",
        "target": "ES2022",
        "declaration": true,
        "strict": true,
        "skipLibCheck": true,
        "strictNullChecks": false,
        "noImplicitAny": false,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "antlr4": [
                "./node_modules/antlr4/dist/antlr4.node.cjs"
            ],
            "@hpcc-js/comms": [
                "./node_modules/@hpcc-js/comms/types/index.node.d.ts",
                "../Visualization/packages/comms/types/index.node.d.ts"
            ],
            "@hpcc-js/*": [
                "./node_modules/@hpcc-js/*",
                "../Visualization/packages/*"
            ]
        }
    },
    "include": [
        "src/extension.ts"
    ]
}